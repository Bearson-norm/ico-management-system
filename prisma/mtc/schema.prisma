generator client {
  provider = "prisma-client-js"
  output   = "../../lib/generated/mtc"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MTC")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  namaLengkap  String    @map("nama_lengkap")
  role         String    @default("viewer") // "viewer" | "editor"
  aktif        Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLogin    DateTime? @map("last_login")

  @@map("users")
}

// ─── Master Data ─────────────────────────────────────────────────────────────

model Teknisi {
  id        Int       @id @default(autoincrement())
  nama      String    @unique
  aktif     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  reports   MaintenanceReport[]
  movements StockMovement[]

  @@map("teknisi")
}

model Mesin {
  id        Int       @id @default(autoincrement())
  nama      String
  tipe      String    @default("perbaikan") // "sparepart" | "perbaikan"
  area      String?
  aktif     Boolean   @default(true)
  vital     Boolean   @default(false) // true = mesin jalur produksi utama, kalau mati produksi ikut turun
  createdAt DateTime  @default(now()) @map("created_at")

  reports    MaintenanceReport[]
  spareparts Sparepart[]

  @@unique([nama, tipe])
  @@map("mesin")
}

model Kategori {
  id        Int       @id @default(autoincrement())
  nama      String    @unique
  tipe      String    @default("umum")
  createdAt DateTime  @default(now()) @map("created_at")

  spareparts Sparepart[]
  reports    MaintenanceReport[]

  @@map("kategori")
}

model Sparepart {
  id         String    @id
  nama       String
  kategoriId Int?      @map("kategori_id")
  uom        String    @default("Pcs")
  lokasi     String?
  harga      Decimal   @default(0) @db.Decimal(14, 2)
  minQty       Int       @default(0) @map("min_qty")
  maxLeadTime  Int       @default(0) @map("max_lead_time")
  avgLeadTime  Float     @default(0) @map("avg_lead_time")
  aktif        Boolean   @default(true)
  purchasingStatus String  @default("NONE") @map("purchasing_status")
  purchasingQty Int       @default(0) @map("purchasing_qty")
  purchasingNoPr String?   @map("purchasing_no_pr")
  purchasingNoPo String?   @map("purchasing_no_po")
  prDate       DateTime? @map("pr_date")
  poDate       DateTime? @map("po_date")
  namaAlias    String?   @map("nama_alias")
  linkReference String?  @map("link_reference")
  alasan       String?   @map("alasan")
  odooNotes    String?   @map("odoo_notes")       // Log pesan Chatter dari Odoo
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  kategori   Kategori?     @relation(fields: [kategoriId], references: [id])
  mesins     Mesin[]
  movements  StockMovement[]
  procurementTrackings ProcurementTracking[]
  opnameItems OpnameItem[]

  @@map("sparepart")
}

// ─── Report Counter (atomic no_report generation) ────────────────────────────

model ReportCounter {
  tipe  String @id
  count Int    @default(0)

  @@map("report_counter")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model MaintenanceReport {
  id          Int      @id @default(autoincrement())
  noReport    String   @unique @map("no_report")
  tipe        String   // "CM" | "PM" | "OH"
  tanggal     DateTime
  startTime   String?  @map("start_time")
  finishTime  String?  @map("finish_time")
  durasiMenit Int?     @map("durasi_menit")
  shift       Int?
  mesinId     Int      @map("mesin_id")
  keluhan     String
  issue       String
  actionTaken String   @map("action_taken")
  kategoriId  Int?     @map("kategori_id")
  picId       Int      @map("pic_id")
  createdAt   DateTime @default(now()) @map("created_at")

  mesin     Mesin     @relation(fields: [mesinId], references: [id])
  kategori  Kategori? @relation(fields: [kategoriId], references: [id])
  pic       Teknisi   @relation(fields: [picId], references: [id])
  movements StockMovement[]

  @@index([tipe])
  @@index([tanggal])
  @@index([mesinId])
  @@index([picId])
  @@map("maintenance_report")
}

model StockMovement {
  id           Int          @id @default(autoincrement())
  tipe         String       // "IN" | "OUT" | "LOG"
  sparepartId  String?      @map("sparepart_id")
  namaItem     String?      @map("nama_item")
  qty          Int
  harga        Decimal      @default(0) @db.Decimal(14, 2)
  lokasi       String?
  picId        Int?         @map("pic_id")
  noReport     String?      @map("no_report")
  purchaseType String?      @map("purchase_type")
  vendor       String?
  keterangan   String?
  tanggal      DateTime     @default(now())
  createdAt    DateTime     @default(now()) @map("created_at")

  sparepart Sparepart?         @relation(fields: [sparepartId], references: [id])
  pic       Teknisi?           @relation(fields: [picId], references: [id])
  report    MaintenanceReport? @relation(fields: [noReport], references: [noReport])

  @@index([sparepartId])
  @@index([tipe])
  @@index([tanggal])
  @@index([noReport])
  @@map("stock_movement")
}

model ProcurementTracking {
  id               Int       @id @default(autoincrement())
  fbIndex          Int?      @map("fb_index") // Nomor baris dari Google Sheets (Fb)
  originalName     String    @map("original_name")
  sparepartId      String?   @map("sparepart_id") // Relasi opsional ke Sparepart database
  keterangan       String?   // "consumable" | "one time purchase" | "project" | "tools" etc.
  penggunaanBulan  Int?      @map("penggunaan_bulan")
  kontrak3Bulan    Boolean   @default(false) @map("kontrak_3_bulan")
  tanggalList      DateTime  @default(now()) @map("tanggal_list")
  qty              Int
  productCategory  String?   @map("product_category")
  reason           String?
  urgency          String?   @default("Normal") // "Normal" | "Urgent"
  linkReferences   String?   @map("link_references")
  vendor           String?
  harga            Decimal?  @db.Decimal(14, 2)
  nomorPr          String?   @map("nomor_pr")
  statusPr         String    @default("DRAFT") @map("status_pr")
  statusPa         String?   @map("status_pa")
  statusPo         String?   @map("status_po")
  nomorPo          String?   @map("nomor_po")
  nomorTe          String?   @map("nomor_te")
  poApproved       Boolean   @default(false) @map("po_approved")
  etaFoom          DateTime? @map("eta_foom")
  linkGr           String?   @map("link_gr")
  tanggalTerima    DateTime? @map("tanggal_terima") // Kapan Terima
  isStocked        Boolean   @default(false) @map("is_stocked")
  sheetId          String?   @map("sheet_id")
  odooNotes        String?   @map("odoo_notes")       // Log pesan Chatter dari Odoo
  linkedPartsJson  String?   @map("linked_parts_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sparepart        Sparepart? @relation(fields: [sparepartId], references: [id])

  @@map("procurement_tracking")
}

model MtcSetting {
  key   String @id
  value String

  @@map("mtc_settings")
}

// ─── Stock Opname ─────────────────────────────────────────────────────────────

model OpnameSession {
  id          Int          @id @default(autoincrement())
  judul       String
  status      String       @default("DRAFT") // "DRAFT" | "WAITING_APPROVAL" | "POSTED" | "REJECTED" | "CANCELLED"
  lokasi      String?
  catatan     String?
  createdById Int?         @map("created_by_id")
  approvedBy  String?      @map("approved_by")
  approvedAt  DateTime?    @map("approved_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  items OpnameItem[]

  @@map("opname_session")
}

model OpnameItem {
  id          Int           @id @default(autoincrement())
  sessionId   Int           @map("session_id")
  sparepartId String?       @map("sparepart_id")
  namaItem    String        @map("nama_item")
  kategori    String?
  lokasi      String?
  uom         String        @default("Pcs")
  qtySistem   Int           @default(0) @map("qty_sistem")
  qtyFisik    Int?          @map("qty_fisik")
  selisih     Int           @default(0)
  catatan     String?
  auditedBy   String?       @map("audited_by")
  isNewItem   Boolean       @default(false) @map("is_new_item")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  session   OpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sparepart Sparepart?    @relation(fields: [sparepartId], references: [id])

  @@map("opname_item")
}



